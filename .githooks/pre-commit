#!/bin/sh
# rev5 pre-commit：機密掃描（rev4:019 三層防線；rev4:scan-gates §S1／§S2）→ docs-sync check（Lint01 生成
# 一致）＋lint（Lint03～Lint25）。被擋時：錯誤訊息附去處；同回合修復後重試。
#
# ★兩種語意（rev4:019 scan-gates；註解即契約）：
#   事件型（機密掃描＋值比對）：--no-verify 繞過＝機密「真進 git 歷史」、不可逆——僅剩
#     pre-push 第二層同套規則補攔；被誤擋一律修 .gitleaks.toml allowlist、絕不養成
#     --no-verify 慣性（慣性＝事件型檢查永久失效）。
#   狀態型（docs-sync check/lint 與工具自測）：--no-verify 只延後、下次 commit 檢查不消失。
#
# 樣式掃描（S1、事件型）：★--redact 不可省（預設 0＝明文噴進終端與 scrollback）；★一律 git
# 子命令（禁 protect/detect——兩專案皆已隱藏、無文件保證）；★原生二進位、禁容器形式（容器
# 不帶 GIT_INDEX_FILE → `git commit -a` 掃 0 bytes 靜默漏報）；exit code 分流＝2 機密命中／
# 其餘非零＝掃描器本身異常（含 127 缺 binary）。
# ★`--config` **顯式帶、不靠自動探索**（rev4:019 final review 實證）：自動探索找不到 `.gitleaks.toml`
#   時 betterleaks **靜默降級為內建規則庫並回 rc=0**——自訂 DSN 規則與兩條 allowlist 一併下線，
#   而 hook 只看 rc 故一路綠（實測：同一 DSN fixture 無 config 時 rc=0、放回後 rc=2）。顯式帶則
#   config 缺席即 rc=1 落入「掃描器本身異常」分支＝吵鬧失敗。此前源倉 hook 因需跨 repo 定位而
#   本就顯式帶、外層卻靠探索＝兩者失敗語意不對稱，本行消除該不對稱。
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# ── 全鏈時間門檻（rev5 新增；Q7 拍板 2026-08-04／§0.3 準則 5）─────────────────
# rev4 自 46.4s 劣化至 104.6s（2.2 倍）全程**零警報**，事後 O(1) 化才修回 15.7s；
# 每收一條 BACKLOG 永久增約 7s 的慢路徑，形成「治理紀律越好、閘越慢」的 --no-verify
# 反誘因。兩級分離「察覺」與「硬擋」：20s 警示劣化趨勢但放行（不因一次環境抖動卡住
# 工作流）、45s 硬擋（rev4 的劣化**起點** 46.4s 恰被擋下，不會再漂到 104.6s 才靠人感覺）。
# ★須容兩平台：同一份工具 drvfs 實測 lint 約 19s、APFS 約 1.27s（差一個量級）；45s 對
#   rev4 在 WSL2 的健康值 15.7s 有 3 倍餘裕。
# ★門檻調整走 ADR（§0.3 準則 5 慣例），不得就地改數字了事。
PRECOMMIT_WARN_SEC=20
PRECOMMIT_FAIL_SEC=45
PRECOMMIT_T0=$(date +%s)
betterleaks git --config "$HOOK_DIR/../.gitleaks.toml" --pre-commit --staged --redact --verbose --exit-code 2
scan_rc=$?
if [ "$scan_rc" -eq 2 ]; then
  echo "[pre-commit] ✗ 機密樣式命中（上方輸出含 rule id 與檔案行、值已遮蔽）——自 staged 移除後重試；誤報→修 .gitleaks.toml allowlist（AND＋paths×regexes 圈定）、絕不 --no-verify" >&2
  exit 1
elif [ "$scan_rc" -ne 0 ]; then
  echo "[pre-commit] ✗ 掃描器本身異常（exit ${scan_rc}）、非機密命中——跑 bash tools/bootstrap.sh 檢修（安裝／版本斷言）" >&2
  exit 1
fi
# 值比對層（S2、事件型、僅外層）：機密現值 × staged 新增行；現值缺席＝skip（fail-open）；
# 紅綠 self-test 每次連帶跑（防恆綠）。
python3 tools/secret-value-guard.py check || exit 1
python3 tools/docs-sync.py check || exit 1
python3 tools/docs-sync.py lint || exit 1
# 守門工具自測條件觸發（rev4:FR-015／data-model §8）：staged 含某工具本體才跑該支、平時零開銷。
# ★名冊改列**相對路徑**（B-035 U2／ADR 0010）：受治理的 python 工具不再只住 tools/，
#   deploy/ 的機密管線腳本轉 python 後同列本名冊；本行與 docs-sync 的 TOOLS_PY、
#   tools/bootstrap.sh 的 run_tool_test 三處手抄，由 docs-sync 自測對賬（漏接線即紅）。
staged=$(git diff --cached --name-only)
for t in tools/docs-sync.py tools/schema-gate.py tools/wire-schema.py tools/secret-value-guard.py tools/entity-drift-gate.py tools/wf-watchdog.py deploy/preflight-secrets.py deploy/decrypt-secrets.py deploy/generate-secrets.py deploy/setup-reaper-role.py deploy/backup-db.py; do
  if echo "$staged" | grep -qxF "$t"; then
    python3 "$t" test || exit 1
  fi
done
# 管理頁「零原始 HTML 插值」機器守（spec 004 FR-038／T042①）：base-web gitlink 變動（pin bump）或
# 本工具本體 staged 時，掃 base-web/src/views/manage/** 的原始 HTML 注入用法。自由文字欄（IP 規則
# 備註欄是第一個）一旦從預設插值改成原始 HTML 插值，**畫面上看不出差別**——備註是純文字時兩者
# 渲染一樣，要等到有人存進帶事件處理器的標記才爆、且爆的是別人的瀏覽器；型別檢查（都是 string）
# 與 code review（一行 diff、像是換個寫法）都抓不穩，只有機器守擋得住。
# ★純檔案掃描、毫秒級、不碰 docker／node，故可掛進秒級預算（工具檔頭同段論證）。
# ★不進上方 `for t in …` 自測名冊迴圈：該迴圈與 docs-sync 的 TOOLS_PY 真表逐字對賬（混入名冊外
#   工具即紅），而本工具的 self-test 每次 check 都連帶跑（同 fork-delta-lint 既有形、防恆綠）。
if echo "$staged" | grep -qxF -e 'base-web' -e 'tools/view-render-guard.py'; then
  # ★worktree 未就位具名跳過（fresh clone、bootstrap 前）：掃描射程整棵缺席時工具回 rc=2，
  #   會擋住創世期 commit——同 fork-delta／entity-drift 兩處既有 Day-1 模式（ADR 0001 決定 4）。
  #   ★條件刻意取 `base-web/src`（worktree 在不在）而非掃描射程 views/manage 本身：worktree
  #   在位卻少了 views/manage＝目錄被搬走／改名，那正是工具要 fail-loud 的情境，不能在這裡
  #   被跳過分支吞掉（吞掉＝守門實質下線而 hook 全綠）。
  if [ -d "$HOOK_DIR/../base-web/src" ]; then
    python3 tools/view-render-guard.py check || exit 1
  else
    echo "[pre-commit] ⤳ view-render-guard 跳過：base-web worktree 未就位（base-web/src/ 缺席）——跑 bash tools/bootstrap.sh 建置後自動恢復實跑"
  fi
fi
# fork-delta 原行 紀律（憲法 §III L114）：base-web gitlink 變動（pin bump）時機器比對 base-web vs
# example 上游、修改型缺 `原行:` 即擋——不靠人工 review（fork 源倉須在 example 分支＝lint 首步
# 斷言）；工具本體 staged 時亦直跑一次（無 test 介面、self-test 內建）。★兩條件取聯集只跑一次
# ——判定冪等結果必同，drvfs 下單跑約 9s、重跑純付 I/O 稅（rev4:018 U4 實測）。
# ★第三個觸發源＝constitution（003-auth-session T069 起）：`load_roster()` 讀 §III.1／§III.2
#   兩表當授權名冊，該檔遂成 lint 的第二個載重輸入。不納入觸發集的話，純 §V.2 Amendment
#   commit（收窄用途／改軌道名／調表格形制）全程綠燈，違規要等下一次 base-web pin bump 才紅
#   ——而那時錯誤會被誤歸因給那顆 pin bump（訊息只說「軌道名不在授權名冊」）。fail-late 且誤導。
if echo "$staged" | grep -qxF -e 'base-web' -e 'tools/fork-delta-lint.py' -e '.specify/memory/constitution.md'; then
  # ★Day-1 具名跳過（創世期、B9 前）：基線源倉缺席＝工具首步斷言必 die（rc=2）、擋創世
  #   一鍋 commit。解除＝B9 bootstrap 建源倉後本分支自動恢復實跑；新機 clone 後的空窗由
  #   CLAUDE.md §6「掃描防線就位前不落 commit」＋bootstrap 承接（ADR 0001 決定 4 在案）。
  if [ -d "$HOOK_DIR/../fork260509-soybean-admin-base" ]; then
    python3 tools/fork-delta-lint.py || exit 1
  else
    echo "[pre-commit] ⤳ fork-delta-lint 跳過：基線源倉 fork260509-soybean-admin-base/ 缺席（B9 前）——源倉就位後自動恢復實跑"
  fi
fi
# wire-schema 快照 drift 閘（rev4:B-128）：base-web gitlink 變動（pin bump）時重抽 typings 與快照
# byte 比對——sh 只做粗判（gitlink staged 與否）、typings 零變動之細判在 python 內
# （--staged-gate 收窄、省 npx 秒數）；stack 未起＝警告放行（fail-open）；容器可用但重抽
# 失敗／不一致＝擋（fail-loud；補救命令見工具輸出）。
if echo "$staged" | grep -qxF 'base-web'; then
  python3 tools/wire-schema.py check --staged-gate || exit 1
fi
# entity 漂移閘（rev4:B-110 階段 0）：rust-api gitlink 變動（pin bump）或 schema 快照本身 staged 時，
# 比對 entity（rust-api/entity/src）vs 已 commit 快照（docs/ops/reference-src/schema-snapshot.json）
# ——零 docker、秒級；casbin_rule 雙向豁免（rev4:ADR 0015）；欄序歸 gate2（rev4:ADR 0021）、
# index/constraint 歸 gate1、default 不驗（entity 面無此資訊）。兩條件取聯集只跑一次（判定
# 冪等）；有漂移／結構異常＝擋（補救見工具輸出）。
if echo "$staged" | grep -qxF -e 'rust-api' -e 'docs/ops/reference-src/schema-snapshot.json'; then
  # ★Day-1 具名跳過（創世期、schema 基線刀前）：快照檔缺席＝工具 rc=2 環境不可用、會擋
  #   pin 首記 commit。解除＝schema 刀 refresh 產快照後本分支自動恢復實跑；同 fork-delta
  #   Day-1 跳過模式（ADR 0001 決定 4）。快照存在而 drift＝照擋（真故障面不受影響）。
  if [ -f "$HOOK_DIR/../docs/ops/reference-src/schema-snapshot.json" ]; then
    python3 tools/entity-drift-gate.py check || exit 1
  else
    echo "[pre-commit] ⤳ entity-drift-gate 跳過：schema 快照缺席（schema 基線刀前）——快照就位後自動恢復實跑"
  fi
fi

# ── 全鏈耗時評估（僅在全部閘通過後執行；任一閘失敗時上方已 exit）──────────────
PRECOMMIT_ELAPSED=$(( $(date +%s) - PRECOMMIT_T0 ))
if [ "$PRECOMMIT_ELAPSED" -gt "$PRECOMMIT_FAIL_SEC" ]; then
  echo "[pre-commit] ✗ 全鏈耗時 ${PRECOMMIT_ELAPSED}s 超出硬上限 ${PRECOMMIT_FAIL_SEC}s——所有檢查本身已通過，擋下的是**效能劣化**。" >&2
  echo "[pre-commit]   兩條出路：①優化慢路徑（先量哪一段吃掉時間，勿憑猜——rev4 的 rev4:B-113 三個病因候選經實測全數證偽）②立 ADR 調門檻並記錄劣化理由。" >&2
  echo "[pre-commit]   ★本項屬狀態型檢查：--no-verify 只延後、下次 commit 仍會提醒（用於解開「調門檻的 commit 也被自己擋住」的死結）。" >&2
  exit 1
elif [ "$PRECOMMIT_ELAPSED" -gt "$PRECOMMIT_WARN_SEC" ]; then
  echo "[pre-commit] ⚠ 全鏈耗時 ${PRECOMMIT_ELAPSED}s 超出警戒線 ${PRECOMMIT_WARN_SEC}s（硬上限 ${PRECOMMIT_FAIL_SEC}s）——劣化趨勢訊號，放行不擋。" >&2
fi
