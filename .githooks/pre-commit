#!/bin/sh
# rev5 pre-commit：機密掃描（rev4:019 三層防線；rev4:scan-gates §S1／§S2）→ docs-sync check（Lint01 生成
# 一致）＋lint（Lint03～Lint30）。被擋時：錯誤訊息附去處；同回合修復後重試。
#
# ★兩種語意（rev4:019 scan-gates；註解即契約）：
#   事件型（機密掃描＋值比對）：--no-verify 繞過＝機密「真進 git 歷史」、不可逆——僅剩
#     pre-push 第二層同套規則補攔；被誤擋一律修 .gitleaks.toml allowlist、絕不養成
#     --no-verify 慣性（慣性＝事件型檢查永久失效）。
#   狀態型（docs-sync check/lint 與工具自測）：--no-verify 只延後、下次 commit 檢查不消失。
#
# 樣式掃描（S1、事件型）：★--redact 不可省（預設 0＝明文噴進終端與 scrollback）；★一律 git
# 子命令（禁 protect/detect——兩專案皆已隱藏、無文件保證）；★原生二進位、禁容器形式（容器
# 不帶 GIT_INDEX_FILE → `git commit -a` 掃 0 bytes 靜默漏報）；exit code 分流＝2 機密命中／
# 其餘非零＝掃描器本身異常（含 127 缺 binary）。
# ★`--config` **顯式帶、不靠自動探索**（rev4:019 final review 實證）：自動探索找不到 `.gitleaks.toml`
#   時 betterleaks **靜默降級為內建規則庫並回 rc=0**——自訂 DSN 規則與兩條 allowlist 一併下線，
#   而 hook 只看 rc 故一路綠（實測：同一 DSN fixture 無 config 時 rc=0、放回後 rc=2）。顯式帶則
#   config 缺席即 rc=1 落入「掃描器本身異常」分支＝吵鬧失敗。此前源倉 hook 因需跨 repo 定位而
#   本就顯式帶、外層卻靠探索＝兩者失敗語意不對稱，本行消除該不對稱。
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# ── 全鏈時間門檻（rev5 新增；Q7 拍板 2026-08-04／§0.3 準則 5）─────────────────
# rev4 自 46.4s 劣化至 104.6s（2.2 倍）全程**零警報**，事後 O(1) 化才修回 15.7s；
# 每收一條 BACKLOG 永久增約 7s 的慢路徑，形成「治理紀律越好、閘越慢」的 --no-verify
# 反誘因。兩級分離「察覺」與「硬擋」。
# ★**現值之推導＝ADR 0044（2026-08-17，本註解塊即該 ADR 的數字權威）**：全鏈已呈**雙峰**
#   ——恆跑段約 9.9s（絕大多數 commit）vs 收刀簿記型 41.2s（每刀一兩顆），單一錨罩不住。
#   故改為雙錨：WARN=45＝最壞**合法**實測 41.2s 進位（＋約 9% 抖動餘裕）、抓「出現比已量測
#   過的最壞情形更慢的形」；FAIL=90＝該值約 2.2 倍、抓「病態」（掛住的工具、無窮迴圈、
#   環境壞掉——那是分鐘級，90s 仍遠低於它）。
# ★**原記的「對 rev4 WSL2 健康值 15.7s 取 3 倍餘裕」推導已由 ADR 0044 判定不適用**：它預設
#   全鏈有單一代表值。舊 WARN=20s 亦已判定為**假警報**（004 期間每一顆 pin bump commit 都
#   越線放行＝警戒線恆亮、只訓練人忽略它）。
# ★須容兩平台：同一份工具 drvfs 實測 lint 約 19s、APFS 約 1.27s（差一個量級）。
# ★門檻調整走 ADR（§0.3 準則 5 慣例），不得就地改數字了事。
# ★配套引信（ADR 0044）：收刀簿記型 commit 的實測值列為每刀例行量測、append events.jsonl 一筆
#   close_bookkeeping perf 事件（人讀 docs/generated/reference/perf.md、引信機器判＝STATE.md 效能
#   引信行；承載處訂正＝ADR 0070、量測法仍住 RUNBOOK §12.1）；
#   **連續兩刀 ≥60s**（新兩錨中點）即強制觸發「優化慢路徑／再立 ADR／縮減名冊」三者之一。
PRECOMMIT_WARN_SEC=45
PRECOMMIT_FAIL_SEC=90
PRECOMMIT_T0=$(date +%s)
# ── 並行 harness（B-130／ADR 0061）───────────────────────────────────────────
# 全鏈主成本是 **drvfs（9p）單次 I/O 延遲 × 存取次數**，非條款邏輯：2026-08-25 cProfile 顯示
# docs-sync lint 的 19.3s 中檔案系統原語佔 64%（open 1407 次／stat 1428 次），唯一顯著的邏輯
# 成本 scan_id_namespace 僅 7%。而 9p 雖掛載成單一 transport，**支援並發 in-flight 請求**：
# 同一批 269 檔 stat+read，序列 2572ms／並行 4 為 526ms（4.89×）／並行 8 為 406ms（6.33×）。
# ⇒ 各閘彼此獨立（皆唯讀、無共享可變狀態），並行派發即可讓延遲重疊。
# ★betterleaks 與 secret-value-guard **刻意留在序列最前**：兩者屬事件型（機密真進 git 歷史＝
#   不可逆），失敗要最先、最顯眼地擋下；且兩者合計亦僅約 0.6s，並行無收益。
# ★語意保持不變：任一閘非零即 exit 1。差別只在**不再 fail-fast**——全部跑完後依**原順序**
#   回放輸出，一次看齊所有問題（本 repo 紀律是「被擋的是 Claude、同回合修復」，一次看到全部
#   比逐輪擠牙膏省一個數量級的往返）。
# ★輸出隔離：各閘 stdout/stderr 收進暫存檔後依序 cat，故並行不致交錯、錯誤歸因不受影響。
PC_TMP=$(mktemp -d) || { echo "[pre-commit] ✗ 無法建立暫存目錄" >&2; exit 1; }
trap 'rm -rf "$PC_TMP"' EXIT
PC_ORDER=""
# pc_run <標籤> <命令…>：背景執行、輸出與 rc 各存一檔；標籤同時作為回放順序鍵。
pc_run() {
  _pc_label=$1; shift
  PC_ORDER="$PC_ORDER $_pc_label"
  ( "$@" >"$PC_TMP/$_pc_label.out" 2>&1; echo $? >"$PC_TMP/$_pc_label.rc" ) &
}
# pc_join：等齊所有背景閘 → 依派發順序回放輸出 → 任一非零即回 1。
pc_join() {
  wait
  _pc_fail=0
  for _pc_l in $PC_ORDER; do
    [ -s "$PC_TMP/$_pc_l.out" ] && cat "$PC_TMP/$_pc_l.out"
    _pc_rc=$(cat "$PC_TMP/$_pc_l.rc" 2>/dev/null || echo 1)
    if [ "$_pc_rc" -ne 0 ]; then
      echo "[pre-commit] ✗ 閘「${_pc_l}」失敗（exit ${_pc_rc}）——處置見其上方輸出" >&2
      _pc_fail=1
    fi
  done
  return $_pc_fail
}
betterleaks git --config "$HOOK_DIR/../.gitleaks.toml" --pre-commit --staged --redact --verbose --exit-code 2
scan_rc=$?
if [ "$scan_rc" -eq 2 ]; then
  echo "[pre-commit] ✗ 機密樣式命中（上方輸出含 rule id 與檔案行、值已遮蔽）——自 staged 移除後重試；誤報→修 .gitleaks.toml allowlist（AND＋paths×regexes 圈定）、絕不 --no-verify" >&2
  exit 1
elif [ "$scan_rc" -ne 0 ]; then
  echo "[pre-commit] ✗ 掃描器本身異常（exit ${scan_rc}）、非機密命中——跑 bash tools/bootstrap.sh 檢修（安裝／版本斷言）" >&2
  exit 1
fi
# 值比對層（S2、事件型、僅外層）：機密現值 × staged 新增行；現值缺席＝skip（fail-open）；
# 紅綠 self-test 每次連帶跑（防恆綠）。
python3 tools/secret-value-guard.py check || exit 1
pc_run "docs-sync-check" python3 tools/docs-sync.py check
pc_run "docs-sync-lint" python3 tools/docs-sync.py lint
# 守門工具自測條件觸發（rev4:FR-015／data-model §8）：staged 含某工具本體才跑該支、平時零開銷。
# ★名冊改列**相對路徑**（B-035 U2／ADR 0010）：受治理的 python 工具不再只住 tools/，
#   deploy/ 的機密管線腳本轉 python 後同列本名冊；本行與 docs-sync 的 TOOLS_PY、
#   tools/bootstrap.sh 的 run_tool_test 三處手抄，由 docs-sync 自測對賬（漏接線即紅）。
staged=$(git diff --cached --name-only)
for t in tools/docs-sync.py tools/schema-gate.py tools/wire-schema.py tools/secret-value-guard.py tools/entity-drift-gate.py tools/wf-watchdog.py tools/route-artifact-gate.py tools/rust-fmt-gate.py tools/walkthrough-baseline.py deploy/preflight-secrets.py deploy/decrypt-secrets.py deploy/generate-secrets.py deploy/setup-reaper-role.py deploy/backup-db.py; do
  if echo "$staged" | grep -qxF "$t"; then
    pc_run "selftest-$(basename "$t" .py)" python3 "$t" test
  fi
done
# 管理頁「零原始 HTML 插值」機器守（spec 004 FR-038／T042①）：base-web gitlink 變動（pin bump）或
# 本工具本體 staged 時，掃 base-web/src/views/manage/** 的原始 HTML 注入用法。自由文字欄（IP 規則
# 備註欄是第一個）一旦從預設插值改成原始 HTML 插值，**畫面上看不出差別**——備註是純文字時兩者
# 渲染一樣，要等到有人存進帶事件處理器的標記才爆、且爆的是別人的瀏覽器；型別檢查（都是 string）
# 與 code review（一行 diff、像是換個寫法）都抓不穩，只有機器守擋得住。
# ★純檔案掃描、毫秒級、不碰 docker／node，故可掛進秒級預算（工具檔頭同段論證）。
# ★不進上方 `for t in …` 自測名冊迴圈＝具名豁免（docs-sync 的 HOOK_TEST_LOOP_EXEMPT、B-080）：
#   本工具的 self-test 每次 check 都連帶跑（同 fork-delta-lint 既有形、防恆綠），入迴圈＝staged
#   時緊接著 check 再重複跑一次 test；豁免由 checked-copy 測試對賬（幽靈豁免／接線行被拆皆紅）。
if echo "$staged" | grep -qxF -e 'base-web' -e 'tools/view-render-guard.py'; then
  # ★worktree 未就位具名跳過（fresh clone、bootstrap 前）：掃描射程整棵缺席時工具回 rc=2，
  #   會擋住創世期 commit——同 fork-delta／entity-drift 兩處既有 Day-1 模式（ADR 0001 決定 4）。
  #   ★條件刻意取 `base-web/src`（worktree 在不在）而非掃描射程 views/manage 本身：worktree
  #   在位卻少了 views/manage＝目錄被搬走／改名，那正是工具要 fail-loud 的情境，不能在這裡
  #   被跳過分支吞掉（吞掉＝守門實質下線而 hook 全綠）。
  if [ -d "$HOOK_DIR/../base-web/src" ]; then
    pc_run "view-render-guard" python3 tools/view-render-guard.py check
  else
    echo "[pre-commit] ⤳ view-render-guard 跳過：base-web worktree 未就位（base-web/src/ 缺席）——跑 bash tools/bootstrap.sh 建置後自動恢復實跑"
  fi
fi
# seed `sys_menu.component` × 前端 view 集對賬閘（B-088／spec 006 FR-049／T025）：base-web 或 rust-api gitlink
# 變動（pin bump）或本工具本體 staged 時，比對 seed `SEED_SYS_MENU` 塊內 `view.*` 集 ⊆ base-web/src/views/**
# 依 elegant-router 規則導出集（另斷言導出集恰等 imports.ts 產物鍵集）。seed 加一列指向不存在的 view、或
# 搬走／改名一支 view 而忘了動 seed，兩向皆零紅——側欄長出點下去零反應的項（B-008 CDP 實測），只有機器
# 對賬擋得住。具名豁免一列（B-008 餘一張 view＝`view.manage_audit`）住工具常數、到期即紅。
# ★純檔案掃描、毫秒級、不碰 docker／node；self-test 每次 check 連帶跑 ⇒ 不進上方 `for t in …` 迴圈
#   ＝具名豁免（docs-sync 的 HOOK_TEST_LOOP_EXEMPT、同 view-render-guard）。
if echo "$staged" | grep -qxF -e 'base-web' -e 'rust-api' -e 'tools/seed-view-gate.py'; then
  # ★worktree 未就位具名跳過（fresh clone、bootstrap 前）：兩側任一整棵缺席時工具回 rc=2、會擋創世期
  #   commit——同 view-render-guard／fork-delta／entity-drift 既有 Day-1 模式（ADR 0001 決定 4）。
  #   ★條件取 `base-web/src` 與 `rust-api/migration`（worktree 在不在）而非掃描射程本身：worktree 在位
  #   卻少了 views/ 或 seed 檔＝被搬走／改名，那正是工具要 fail-loud 的情境，不能在這裡被吞掉。
  if [ -d "$HOOK_DIR/../base-web/src" ] && [ -d "$HOOK_DIR/../rust-api/migration" ]; then
    pc_run "seed-view-gate" python3 tools/seed-view-gate.py check
  else
    echo "[pre-commit] ⤳ seed-view-gate 跳過：worktree 未就位（base-web/src/ 或 rust-api/migration/ 缺席）——跑 bash tools/bootstrap.sh 建置後自動恢復實跑"
  fi
fi
# fork-delta 原行 紀律（憲法 §III L114）：base-web gitlink 變動（pin bump）時機器比對 base-web vs
# example 上游、修改型缺 `原行:` 即擋——不靠人工 review（fork 源倉須在 example 分支＝lint 首步
# 斷言）；工具本體 staged 時亦直跑一次（無 test 介面、self-test 內建）。★兩條件取聯集只跑一次
# ——判定冪等結果必同，drvfs 下單跑約 9s、重跑純付 I/O 稅（rev4:018 U4 實測）。
# ★第三個觸發源＝constitution（003-auth-session T069 起）：`load_roster()` 讀 §III.1／§III.2
#   兩表當授權名冊，該檔遂成 lint 的第二個載重輸入。不納入觸發集的話，純 §V.2 Amendment
#   commit（收窄用途／改軌道名／調表格形制）全程綠燈，違規要等下一次 base-web pin bump 才紅
#   ——而那時錯誤會被誤歸因給那顆 pin bump（訊息只說「軌道名不在授權名冊」）。fail-late 且誤導。
if echo "$staged" | grep -qxF -e 'base-web' -e 'tools/fork-delta-lint.py' -e '.specify/memory/constitution.md'; then
  # ★Day-1 具名跳過（創世期、B9 前）：基線源倉缺席＝工具首步斷言必 die（rc=2）、擋創世
  #   一鍋 commit。解除＝B9 bootstrap 建源倉後本分支自動恢復實跑；新機 clone 後的空窗由
  #   CLAUDE.md §6「掃描防線就位前不落 commit」＋bootstrap 承接（ADR 0001 決定 4 在案）。
  if [ -d "$HOOK_DIR/../fork260509-soybean-admin-base" ]; then
    pc_run "fork-delta-lint" python3 tools/fork-delta-lint.py
  else
    echo "[pre-commit] ⤳ fork-delta-lint 跳過：基線源倉 fork260509-soybean-admin-base/ 缺席（B9 前）——源倉就位後自動恢復實跑"
  fi
fi
# wire-schema 快照 drift 閘（rev4:B-128）：base-web gitlink 變動（pin bump）時重抽 typings 與快照
# byte 比對——sh 只做粗判（gitlink staged 與否）、typings 零變動之細判在 python 內
# （--staged-gate 收窄、省 npx 秒數）；stack 未起＝警告放行（fail-open）；容器可用但重抽
# 失敗／不一致＝擋（fail-loud；補救命令見工具輸出）。
if echo "$staged" | grep -qxF 'base-web'; then
  pc_run "wire-schema" python3 tools/wire-schema.py check --staged-gate
fi
# entity 漂移閘（rev4:B-110 階段 0）：rust-api gitlink 變動（pin bump）或 schema 快照本身 staged 時，
# 比對 entity（rust-api/entity/src）vs 已 commit 快照（docs/ops/reference-src/schema-snapshot.json）
# ——零 docker、秒級；casbin_rule 雙向豁免（rev4:ADR 0015）；欄序歸 gate2（rev4:ADR 0021）、
# index/constraint 歸 gate1、default 不驗（entity 面無此資訊）。兩條件取聯集只跑一次（判定
# 冪等）；有漂移／結構異常＝擋（補救見工具輸出）。
if echo "$staged" | grep -qxF -e 'rust-api' -e 'docs/ops/reference-src/schema-snapshot.json'; then
  # ★Day-1 具名跳過（創世期、schema 基線刀前）：快照檔缺席＝工具 rc=2 環境不可用、會擋
  #   pin 首記 commit。解除＝schema 刀 refresh 產快照後本分支自動恢復實跑；同 fork-delta
  #   Day-1 跳過模式（ADR 0001 決定 4）。快照存在而 drift＝照擋（真故障面不受影響）。
  if [ -f "$HOOK_DIR/../docs/ops/reference-src/schema-snapshot.json" ]; then
    pc_run "entity-drift-gate" python3 tools/entity-drift-gate.py check
  else
    echo "[pre-commit] ⤳ entity-drift-gate 跳過：schema 快照缺席（schema 基線刀前）——快照就位後自動恢復實跑"
  fi
fi
# rust 格式守門（B-112／ADR 0057）：rust-api gitlink 變動（pin bump）或本工具本體 staged 時，於 rust-api
# 容器內跑 `cargo fmt --all --check`（唯讀、設定＝rust-api/rustfmt.toml）。rust-api 自 002 起全部手寫、
# 從未跑過 rustfmt，而 rev5 零 CI（ADR 0014）⇒ 沒有這一段就沒有任何機器 fmt 判準、只剩「手動對齊既有
# 風格」，而既有風格本身無判準（B-112 立案理由）。
# ★本段刻意**零條件判斷**（與上方四段的 Day-1 形不同）：跳過邏輯住工具內＝ADR 0057 決定 3——docker
#   不可用或 rust-api 容器未在跑＝工具具名跳過 rc 0，「stack 沒起時 pre-commit MUST 可用」紀律不變；
#   容器在跑但映像未含 rustfmt component（舊映像）＝rc 2 fail-loud 附重建命令，刻意不設豁免（靜默跳過
#   ＝守門動作恆不跑，正是 ADR 0024 全篇要消滅的失效類）。跳過分支使離線 commit 仍可能帶入未格式化碼
#   ——下一次 stack 在跑的 pin bump 會擋下，屬延遲一站而非漏網。
# ★本檔**入**上方 `for t in …` 自測迴圈（非 HOOK_TEST_LOOP_EXEMPT）：其 self-test 不隨 check 連帶跑
#   （check 要走 docker、多跑一輪離線自測零收益），故走迴圈形。
# ★本段之耗時中位數與單跑上限住 RUNBOOK §12.1 條件觸發段表；合成推估等資料點自 ADR 0070 起住
#   events.jsonl 的 perf 事件（人讀 docs/generated/reference/perf.md）——「數字只住那一處」⇒ 本處
#   刻意不複寫任何秒數。定性結論：本段使該節之收刀
#   簿記型合成推估**越過 45s 警戒**（越線＝列示放行、不擋；硬擋 90s 仍遠），成因明確＝新增一道
#   容器內守門而非慢路徑劣化。
# ★存量一次格式化 commit 落地後 diff 段數歸零，但本段成本**不等比下降**（仍需全樹解析）——屆時重測。
if echo "$staged" | grep -qxF -e 'rust-api' -e 'tools/rust-fmt-gate.py'; then
  pc_run "rust-fmt-gate" python3 tools/rust-fmt-gate.py check
fi

# ── 等齊所有並行閘、依原順序回放輸出（B-130）───────────────────────────────
pc_join || exit 1

# ── 全鏈耗時評估（僅在全部閘通過後執行；任一閘失敗時上方已 exit）──────────────
PRECOMMIT_ELAPSED=$(( $(date +%s) - PRECOMMIT_T0 ))
if [ "$PRECOMMIT_ELAPSED" -gt "$PRECOMMIT_FAIL_SEC" ]; then
  echo "[pre-commit] ✗ 全鏈耗時 ${PRECOMMIT_ELAPSED}s 超出硬上限 ${PRECOMMIT_FAIL_SEC}s——所有檢查本身已通過，擋下的是**效能劣化**。" >&2
  echo "[pre-commit]   兩條出路：①優化慢路徑（先量哪一段吃掉時間，勿憑猜——rev4 的 rev4:B-113 三個病因候選經實測全數證偽）②立 ADR 調門檻並記錄劣化理由。" >&2
  echo "[pre-commit]   ★本項屬狀態型檢查：--no-verify 只延後、下次 commit 仍會提醒（用於解開「調門檻的 commit 也被自己擋住」的死結）。" >&2
  exit 1
elif [ "$PRECOMMIT_ELAPSED" -gt "$PRECOMMIT_WARN_SEC" ]; then
  echo "[pre-commit] ⚠ 全鏈耗時 ${PRECOMMIT_ELAPSED}s 超出警戒線 ${PRECOMMIT_WARN_SEC}s（硬上限 ${PRECOMMIT_FAIL_SEC}s）——劣化趨勢訊號，放行不擋。" >&2
fi
